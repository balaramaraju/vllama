    },
    "optimizer": {
      "lr": 0.0003
    },
    "training": {
      "max_steps": 10000,
      "log_every": 10
    },
    "checkpoint": {
      "checkpoint_dir": "./checkpoints/llama_3b",
      "resume": true,
      "load_from": null,
      "save_every": 5000,
      "save_final": true,
      "keep_last": 2,
      "first_save_at": 500
    },
    "profile": {
      "skip_first": 10,
      "wait": 5,
      "warmup": 2,
      "active": 5,
      "repeat": 1,
      "max_steps": 25,
      "trace_dir": "./log/fsdp_profile"
    }
