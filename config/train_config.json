{
  "training_data": {
    "hf_path": null,
    "hf_name": null,
    "split": "train",
    "block_size": 4096,
    "batch_size": 16,
    "is_local_file": true,
    "tokenizer_path": "./llama_tokenizer_local",
    "wait_for_data": true,
    "poll_interval": 1.0,
